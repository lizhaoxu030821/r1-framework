  <sensor>
    <!-- <framequat name="pelvis-quat" objtype="site" objname="imu_in_pelvis" />
    <velocimeter name="pelvis-velocity" site="imu_in_pelvis" />
    <gyro name="pelvis-angular-velocity" site="imu_in_pelvis" noise="5e-4" cutoff="34.9"/>
    <accelerometer name="pelvis-linear-acceleration" site="imu_in_pelvis" noise="1e-2" cutoff="157"/>
    <touch name="lf-touch" site="lf-tc" />
