    <gyro          name='angular-velocity'    site='imu_in_pelvis' noise='0.005' cutoff='34.9'/>
    <velocimeter   name='linear-velocity'     site='imu_in_pelvis' noise='0.001' cutoff='30'/>
    <accelerometer name='linear-acceleration' site='imu_in_pelvis' noise='0.005' cutoff='157'/>
