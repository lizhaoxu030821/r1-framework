<mujoco model="robot_zky">
  
  <compiler angle="radian" meshdir="../meshes/" autolimits="true"/>

  <option timestep="0.001"  tolerance="1e-10" solver="Newton" jacobian="dense" cone="pyramidal" gravity="0 0 -9.81">  <!--integrator="RK4"  iteration="50"-->
        <flag contact="enable" energy="enable"/>
  </option>
  
  <size njmax="500" nconmax="1000" /> 
  <statistic meansize="0.124491" extent="1.47932" center="0.0977106 1.30029e-06 0.632631"/>
  <default>
      <light castshadow="false" />
      <!-- <geom rgba="0.784 0.784 0.784 1"/> -->
      <!-- <joint limited='true'/>
      <motor ctrllimited="true"/> -->
      <geom condim="4" contype="1" friction="0.9 0.2 0.2" solref="0.002 1" solimp="0.95 0.99 0.001" conaffinity="15"/>
      <!-- <equality solref="0.001 1" /> -->
      <default class='leg_joint_param'>
        <joint limited='true' damping="0.01" frictionloss="0.01" armature="0.01"/>
      </default>
      <default class="visual">
          <geom contype="0" conaffinity="0" group="1" type="mesh" euler="1.57 0 0" />
      </default>
      <default class="collision">
          <geom contype="1" conaffinity="1" friction="1.0 0.3 0.3" 
                margin="0.001" group="0" euler="0 0 0" 
                solref="0.05 2" 
                solimp="0.9 0.95 0.001"/>  
              

      </default>
      <joint damping="0.1" frictionloss="0.02" armature="0.01"/>
  </default>

  <asset>
    <mesh name="pelvis" file="pelvis.STL"/>
    <mesh name="left_hip_yaw_link" file="left_hip_yaw_link.STL"/>
    <mesh name="left_hip_roll_link" file="left_hip_roll_link.STL"/>
    <mesh name="left_hip_pitch_link" file="left_hip_pitch_link.STL"/>
    <mesh name="left_knee_link" file="left_knee_link.STL"/>
    <mesh name="left_ankle_pitch_link" file="left_ankle_pitch_link.STL"/>
    <mesh name="left_ankle_roll_link" file="left_ankle_roll_link.STL"/>
    <mesh name="right_hip_yaw_link" file="right_hip_yaw_link.STL"/>
    <mesh name="right_hip_roll_link" file="right_hip_roll_link.STL"/>
    <mesh name="right_hip_pitch_link" file="right_hip_pitch_link.STL"/>
    <mesh name="right_knee_link" file="right_knee_link.STL"/>
    <mesh name="right_ankle_pitch_link" file="right_ankle_pitch_link.STL"/>
    <mesh name="right_ankle_roll_link" file="right_ankle_roll_link.STL"/>
    <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="512" height="512" mark="cross" markrgb=".8 .8 .8" />
    <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="1 1" texuniform="true" />   
    <!-- Complex terrain assets (hfields, textures, materials) -->
    <hfield file="../mujoco_complex_terrain/terrain/hills.png"     name="hills" size="10 10 0.1 0.1"/>
    <hfield file="../mujoco_complex_terrain/terrain/noise.png"     name="noise" size="10 10 0.07 0.1"/>
    <hfield file="../mujoco_complex_terrain/terrain/rock.png"      name="rock"  size="10 10 0.07 0.1"/>
    <hfield file="../mujoco_complex_terrain/terrain/wavefield.png" name="wave"  size="10 10 0.1 0.1"/>
    <hfield file="../mujoco_complex_terrain/terrain/slope.png"     name="slope" size="5 5 0.5 0.1"/>
    <texture name="texgress"  type="2d" file="../mujoco_complex_terrain/photos/gress.png" width='512' height='512'/>
    <texture name="texcarpet" type="2d" file="../mujoco_complex_terrain/photos/carpet.png" width='512' height='512'/>
    <texture name="texsponge" type="2d" file="../mujoco_complex_terrain/photos/sponge.png" width='512' height='512'/>
    <texture name="texnoise"  type="2d" file="../mujoco_complex_terrain/photos/greynoise.png" width='512' height='512'/>
    <texture name="texrock"   type="2d" file="../mujoco_complex_terrain/photos/rock.png" width='512' height='512'/>
    <texture name="textv"     type="2d" file="../mujoco_complex_terrain/photos/TV.png" width='512' height='512'/>
    <material name="matgress"  texture="texgress"/>
    <material name="matcarpet" texture="texcarpet"/>
    <material name="matsponge" texture="texsponge"/>
    <material name="matnoise"  texture="texnoise"/>
    <material name="matrock"   texture="texrock"/>
    <material name="mattv"     texture="textv"/>
  </asset>

